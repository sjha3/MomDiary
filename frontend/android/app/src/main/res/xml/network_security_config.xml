<?xml version="1.0" encoding="utf-8"?>
<!--
Network security configuration for MomDiary.

Allows cleartext HTTP for dev backends only:
  - 10.0.2.2  : the Android emulator's alias for the host machine's localhost
  - localhost : in case anything inside the app talks to itself over plain http
  - 192.168.*.*, 10.*.*.*, 172.16.*.*  : common LAN ranges so a physical phone
    on the same Wi-Fi can reach the dev laptop without HTTPS

The default-config block keeps cleartext **denied** for every other host, so a
production build pointed at `https://api.momdiary.example` cannot accidentally
fall back to plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.88.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>
