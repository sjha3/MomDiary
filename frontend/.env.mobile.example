# MomDiary mobile build environment.
#
# Vite picks this up via `--mode mobile` (npm run build:mobile).
# Production mobile shells MUST point at a publicly-reachable backend; the
# device cannot reach `http://localhost:8000` from outside your dev machine.
#
# For dev-against-laptop testing, replace this with your machine's LAN IP:
#   VITE_API_BASE_URL=http://192.168.1.42:8000
# and start uvicorn with --host 0.0.0.0. Remember to allow the LAN origin in
# the backend CORS list.

VITE_API_BASE_URL=https://api.momdiary.example

# Same Clerk publishable key as the web build. Native apps use the same Clerk
# instance; OAuth deep-link setup comes in Phase 3 (Auth deep-links).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
